# Production go-live gate (TASK-032 S7): `npm run verify:production` reads these and nothing else. Copy to `.env.gate` (ignored by git) or
# set them in the environment / GitHub Actions secrets. They are deliberately named GATE_* so the gate can never judge whichever environment
# `.env.local` happens to point at. The gate changes nothing; it only reads and probes.

# --- Required ---------------------------------------------------------------------------------------------------------------------------
# The deployment being judged, and what it must say it is ("production" or "staging"; staging is the dress rehearsal).
GATE_BASE_URL=
GATE_EXPECTED_ENVIRONMENT=
# That deployment's CRON_SECRET (its /api/health/config needs it).
GATE_CRON_SECRET=
# That deployment's Supabase project: its URL and service key (the gate calls the read-only public.gate_snapshot()).
GATE_SUPABASE_URL=
GATE_SUPABASE_SECRET_KEY=

# --- Optional: each one turns a PENDING check into a real answer ---------------------------------------------------------------------
# The commit that should be live (a full or 7-character sha). Without it the build id is shown but not compared (G1).
GATE_EXPECTED_COMMIT=
# Another environment to compare against, normally staging when judging production: proves no secret or identifier is shared (G6).
GATE_REFERENCE_BASE_URL=
GATE_REFERENCE_CRON_SECRET=
# The production worker's address, for /healthz and /readyz (G7).
GATE_WORKER_URL=
# The real webhook verify tokens, to prove each handshake works (G8). Forged and unsigned events are checked without them.
GATE_VERIFY_TOKEN_WHATSAPP=
GATE_VERIFY_TOKEN_MESSENGER=
GATE_VERIFY_TOKEN_INSTAGRAM=
# A Vercel token that can read deployments, the project id, and the team id if there is one, to confirm a previous production build exists (G13).
GATE_VERCEL_TOKEN=
GATE_VERCEL_PROJECT=
GATE_VERCEL_TEAM=
# Where to write the markdown report as well as printing it.
GATE_REPORT_PATH=
