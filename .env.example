# Copy to .env.local and fill in real values. Never commit .env.local.

# ── Required — the app will not build/run without these ─────────────────────
# Supabase project URL and publishable (anon) key. Safe to expose to the
# browser (NEXT_PUBLIC_*) — every table is protected by Row Level Security,
# not by keeping this key secret. Find both under Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Inbox scaling baseline: execution is staging-only by default. A disposable
# current project is allowed only when its data is intentionally non-live and
# this exact confirmation is set; never use that mode with customer data.
LOAD_TEST_ENVIRONMENT=
LOAD_TEST_PROJECT_REF=
LOAD_TEST_PRODUCTION_PROJECT_REF=
LOAD_TEST_DISPOSABLE_CONFIRMATION=

# LR2 Inbox browser acceptance. Run only against staging or a disposable project:
# test:e2e refuses a target project ref that matches production. Keep test
# passwords in .env.local or CI secrets, never git.
INBOX_E2E_ENVIRONMENT=
INBOX_E2E_BASE_URL=
INBOX_E2E_PROJECT_REF=
INBOX_E2E_PRODUCTION_PROJECT_REF=
INBOX_E2E_A1_EMAIL=
INBOX_E2E_A1_PASSWORD=
INBOX_E2E_A2_EMAIL=
INBOX_E2E_A2_PASSWORD=
INBOX_E2E_A_READONLY_EMAIL=
INBOX_E2E_A_READONLY_PASSWORD=
INBOX_E2E_B1_EMAIL=
INBOX_E2E_B1_PASSWORD=
INBOX_E2E_A_OPEN_CONVERSATION_ID=
INBOX_E2E_A_TAKE_CONTROL_CONVERSATION_ID=
INBOX_E2E_A_CLOSED_WINDOW_CONVERSATION_ID=
INBOX_E2E_A_COWORKER_CONVERSATION_ID=
INBOX_E2E_B_CONVERSATION_ID=
# TASK-030 search tests: text that appears in a visible row of ONE agency's conversations only (a contact name works well).
INBOX_E2E_A_SEARCH_TERM=
INBOX_E2E_B_SEARCH_TERM=
# TASK-030 ownership, bulk and composer tests: Staff A2's name as shown in the owner picker, and an approved WhatsApp template for Agency A.
INBOX_E2E_A2_NAME=
INBOX_E2E_TEMPLATE_NAME=

# ── Required in production, optional in local dev ───────────────────────────
# Absolute origin of this deployment (e.g. https://crm.royalalfathima.lk).
# Used to build the links inside Supabase's magic-link / password-recovery
# emails (see lib/site-url.ts). Falls back to the request's Host header when
# unset, which is fine for local dev but must be set explicitly in
# production — otherwise a misconfigured proxy could redirect auth emails to
# the wrong origin.
NEXT_PUBLIC_SITE_URL=

# ── Sentry error tracking (TASK-028 P1.2) — optional; the SDK stays off without a DSN ──
# The DSN is not a secret but it differs per environment, so it lives here, never in code.
# Web app: NEXT_PUBLIC_SENTRY_DSN reaches the browser; SENTRY_DSN is server-only and wins on the server.
# Worker: SENTRY_DSN (+ SENTRY_RELEASE = the deployed commit SHA).
# SENTRY_AUTH_TOKEN uploads source maps at build time only (a build secret on Vercel; never NEXT_PUBLIC_).
# Use a different environment name per deployment ("staging" today, "production" once it exists); trace rate is 0 to 1, default 0.1.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ENVIRONMENT=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
SENTRY_TRACES_SAMPLE_RATE=
SENTRY_AUTH_TOKEN=

# ── Outbound allow-list (outside production only; docs/runbooks/outbound-allowlist.md) ──────────────────────────────
# Outside production the app sends only to the contacts named here. EMPTY OR UNSET MEANS NOBODY. Comma-separated: phone numbers (digits,
# any spelling), e-mail addresses, or Messenger/Instagram scoped ids. `*` allows everyone (use only on a deployment with no real customers).
# Ignored in production, where setting it is reported as a configuration problem. Contains phone numbers: keep it out of git and logs.
INBOX_OUTBOUND_ALLOWLIST=
# ── Inbox worker (docs/runbooks/inbox-worker.md) ─────────────────────────────
# Set to 1 on the WEB deployment once an always-on worker is running, so the web app stops draining the queues itself
# (the cron routes stay as the guarantee). Leave unset until a worker is actually running.
INBOX_WORKER_ACTIVE=
# ── Optional — specific features stay off without these ─────────────────────
# Service-role key. Never exposed to the browser (no NEXT_PUBLIC_ prefix; see
# utils/supabase/admin.ts, which is marked `server-only`). Without it, Team
# administration cannot invite staff, reset a colleague's password, or
# revoke sessions — the UI hides those controls rather than failing loudly.
# Find it under Project Settings > API > service_role (or the new "secret"
# key, depending on your project's key format).
SUPABASE_SECRET_KEY=

# Self-serve agency signup (docs/architecture/multi-tenancy-implementation-plan.md D6 /
# Phase 5). "invite_only" (the default when unset) hides app/(auth)/signup
# behind a "contact us" message — new agencies are created from the
# platform console (/platform/agencies/new) or by hand. Set to "open" to
# let a visitor request their own workspace; provisioning still only runs
# after they confirm the invite email SIGNUP_MODE=open sends, never before.
SIGNUP_MODE=invite_only

# ALL AI runs through OpenRouter (one key, one bill) — there is no Anthropic key. The OPENROUTER_API_KEY
# below powers the WhatsApp assistant, the Document Agent, Departure Ops, Finance and Leads AI. Without it,
# WhatsApp messages still arrive and are stored (the Inbox works as a plain shared inbox), they just aren't
# answered automatically. See docs/modules/whatsapp-ai-agent-implementation-plan.md §15.
# Optional model overrides (OpenRouter slugs; the defaults were chosen for cost, see
# docs/architecture/ai-model-selection.md). Leave blank to use the defaults.
#   AI_AGENT_MODEL     default openai/gpt-5.6-luna      WhatsApp assistant, Departure Ops, Finance agent
#   AI_CLASSIFY_MODEL  default openai/gpt-5.6-luna      cheap classification
#   AI_REASON_MODEL    default google/gemini-3.8-flash  explanations touching money/eligibility, document reading
#   AI_DRAFT_MODEL     default google/gemini-3.8-flash  customer-facing drafts and summaries
#   AI_TRANSCRIBE_MODEL default google/gemini-3.8-flash voice-note transcripts (must accept audio input); off until an agency enables the inbox_voice_transcript surface
AI_AGENT_MODEL=
AI_CLASSIFY_MODEL=
AI_REASON_MODEL=
AI_DRAFT_MODEL=
AI_TRANSCRIBE_MODEL=
# OPT-IN free model for WhatsApp chats no staff member has touched yet (falls back to AI_AGENT_MODEL on any
# failure). Leave empty (or "off") to always use the paid model, which is the default. Free models are
# rate-limited and the provider may log prompts, and those first messages carry customers' names, numbers and
# passport questions. Example: AI_FREE_CHAT_MODEL=inclusionai/ling-3.0-flash-vl:free
AI_FREE_CHAT_MODEL=
# What OpenRouter may do with prompts: "deny" = only providers that do not collect or train on data; "zdr" = also
# zero-data-retention endpoints only. Unset = no restriction (OpenRouter account privacy settings still apply). A
# model with no qualifying provider then FAILS, so enable it in staging first and check every AI surface answers.
OPENROUTER_DATA_POLICY=

# OpenRouter — the LLM behind the Leads "Manasik Decision" (Sales
# Intelligence Engine, lib/copilot/sales/llm/). Optional: without a key every
# Manasik Decision flow still works on the deterministic rules engine, and the
# UI labels results "rules-based". With a key, enquiry analysis, free-form
# Ask Manasik questions and reply tone/translation use the model below; every
# model output is schema-validated and safety-audited, falling back to rules
# on any failure. Pasted enquiry text is sent to OpenRouter when enabled.
OPENROUTER_API_KEY=
# Any chat model slug from https://openrouter.ai/models
OPENROUTER_MODEL=google/gemini-3.8-flash
# WhatsApp knowledge base: meaning-based search over the agency's documents. Uses the
# OPENROUTER_API_KEY above; without it, documents are still searchable by keyword. The model must
# produce 1024-dimensional vectors (baai/bge-m3 does, and it handles Sinhala and Tamil).
KNOWLEDGE_EMBEDDING_MODEL=baai/bge-m3
# WhatsApp voice notes: speech to text through an audio-capable OpenRouter model (uses the same
# OPENROUTER_API_KEY). Ogg/Opus voice notes are sent as they are; the recording is not stored. Check
# accuracy in Sinhala and Tamil with real recordings before relying on it for those languages.
VOICE_TRANSCRIPTION_MODEL=google/gemini-3.5-flash-lite

# ── WhatsApp — Meta app credentials, OURS, not a tenant's ────────────────────
# One Meta app serves every Mode B (Embedded Signup) agency; each agency's
# own WABA token is obtained through the popup at runtime and stored in
# Supabase Vault, never here (D4). Mode A (own Meta app / Basic Setup)
# tenants never touch these — see connectWhatsAppOwnApp() and D3 of
# docs/modules/whatsapp-meta-connection-implementation-plan.md.
#
# All server-side, with NO NEXT_PUBLIC_ twins. The app id and config id are
# not secret (they travel in the OAuth URL anyway), but they are read on the
# server and passed to the connect card as props — deliberately, so there is
# exactly one value for each. An earlier version kept NEXT_PUBLIC_ copies and
# the browser silently ran against a different config id than the Server
# Action, producing Meta's opaque "config_id is required" error — do not
# reintroduce a NEXT_PUBLIC_META_* pair.
META_APP_ID=
META_APP_SECRET=               # verifies X-Hub-Signature-256 on the unkeyed route; exchanges the signup auth code; also the "app secret" half of debug_token's app access token for Mode A verification
META_CONFIG_ID=                # Embedded Signup configuration id — must be v4, not v2 (F6). Only meaningful once WHATSAPP_CONNECT_MODE is embedded/both
META_GRAPH_VERSION=v25.0       # Embedded Signup v4 requires v25.0 or newer
WHATSAPP_VERIFY_TOKEN=          # our own random string, for the UNKEYED webhook route only; echoed back at subscription time. Each Mode A tenant gets its own generated verify token instead (D3), never this one
# ── Messenger (same Meta app as above — one webhook, one secret, every agency's Page) ─────────
# Webhook: object "page", callback https://<domain>/api/webhooks/messenger, fields messages, messaging_postbacks,
# message_deliveries, message_reads, message_echoes. Signatures are verified with META_APP_SECRET; echoes from
# our own sends are recognised by META_APP_ID. Set META_GRAPH_VERSION explicitly (Meta's Messenger docs show v25.0).
MESSENGER_VERIFY_TOKEN=          # our own random string; echoed back when Meta subscribes the page webhook
META_MESSENGER_CONFIG_ID=        # Facebook Login for Business configuration for Messenger connect: Page assets with pages_messaging, pages_manage_metadata, pages_show_list. Add https://<domain>/ to Valid OAuth Redirect URIs (already there for WhatsApp)
# ── Instagram (same Meta app; its OWN onboarding and configuration — docs/runbooks/instagram-meta-setup-and-test.md) ─────────
# Two ways to connect, both writing provider INSTAGRAM. PRIMARY: Instagram Login (no Facebook Page): the agency signs in
# with Instagram itself (docs/tasks/TASK-006-instagram-login-connection.md). FALLBACK: through the connected Facebook Page.
# Webhook (both): object "instagram", callback https://<domain>/api/webhooks/instagram, fields messages, messaging_postbacks, messaging_seen.
INSTAGRAM_APP_ID=                # Instagram Login: the INSTAGRAM app id from the Instagram product page (not META_APP_ID). Register https://<domain>/api/oauth/instagram-login/callback as the business-login redirect URL
INSTAGRAM_APP_SECRET=            # Instagram Login: the Instagram app secret (code + long-lived token exchange); also a webhook signing candidate, accepted alongside META_APP_SECRET
META_INSTAGRAM_CONFIG_ID=        # FALLBACK (through a Page): Facebook Login for Business configuration with Page + Instagram assets, instagram_manage_messages, instagram_basic, pages_show_list, pages_manage_metadata
INSTAGRAM_VERIFY_TOKEN=          # optional: falls back to MESSENGER_VERIFY_TOKEN

# Every agency connects WhatsApp the same way: Meta Embedded Signup (no per-agency tokens, apps or webhook URLs).
# See docs/architecture/whatsapp-multi-tenant-connection.md for the Meta app settings this needs.

# Meta Ads (Facebook/Instagram) — Campaigns V3 ad-platform spend sync.
# A SEPARATE Meta app from META_APP_ID above (WhatsApp and Ads are
# different products in Meta's app dashboard, each with their own review):
# add the "Marketing API" product, request the ads_read permission, and set
# this app's OAuth redirect URI to <your domain>/api/oauth/meta-ads/callback.
# Until Meta approves ads_read for the app, the connect card works against
# your own ad accounts only (development mode) — see
# app/(main)/management/settings/integrations/meta-ads-connect-card.tsx.
META_ADS_APP_ID=
META_ADS_APP_SECRET=

# Google Ads — Campaigns V3 ad-platform spend sync. GOOGLE_ADS_CLIENT_ID/
# SECRET come from a Google Cloud OAuth 2.0 Client ID (Web application type;
# add <your domain>/api/oauth/google-ads/callback as an authorized redirect
# URI). GOOGLE_ADS_DEVELOPER_TOKEN is issued separately by applying for
# Google Ads API access on the agency's own Google Ads manager account —
# starts in test-account-only mode until Google approves Basic/Standard
# access. See app/(main)/management/settings/integrations/google-ads-connect-card.tsx.
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=

# Bearer token every cron route requires: the WhatsApp queue drain
# (GET /api/cron/agent-jobs), token/connection health
# (GET /api/cron/whatsapp-health), the nightly billing sync
# (GET /api/cron/whatsapp-billing-sync), the Departure Ops queue drain
# (GET /api/cron/departure-ops-jobs), and the seat-hold sweep
# (GET /api/cron/release-seat-holds). One secret, five routes.
#
# Scheduling is done INSIDE Supabase (pg_cron + pg_net —
# supabase/migrations/20260927090000_cron_jobs.sql), not by this app or by
# a host-level cron. After setting this variable here, run once per
# environment from the Supabase SQL editor (service_role):
#
#   select public.set_cron_http_config('https://your-domain.example', 'the exact value of CRON_SECRET below');
#
# Until that call is made, the scheduled jobs fire on time but do nothing —
# invoke_cron_route() logs a warning and returns rather than guessing a URL
# or skipping the auth header. Re-run set_cron_http_config() whenever the
# deployment's domain or this value changes.
CRON_SECRET=

# Days of billing history the nightly sync re-pulls each run — Meta restates
# recent days, so a single-day sync silently under-reports (§5 E10). The
# first sync for a newly connected agency always backfills 90 days
# regardless of this setting, so the Billing screen is useful on day one.
WHATSAPP_BILLING_SYNC_WINDOW_DAYS=7

# Optional performance timing (docs/runbooks/performance-baseline-runbook.md). Leave unset normally.
# PERF_TIMING=1
# NEXT_PUBLIC_PERF_TIMING=1

# ── Inbox scale test (staging only) ─────────────────────────────────────────
# The runner refuses to execute unless all three values prove it is pointed at
# an isolated staging project, not production. Do not set these in production.
LOAD_TEST_ENVIRONMENT=
LOAD_TEST_PROJECT_REF=
LOAD_TEST_PRODUCTION_PROJECT_REF=
