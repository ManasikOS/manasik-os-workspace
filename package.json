{
  "name": "crm",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --experimental-https --experimental-https-key ./certificates/localhost-key.pem --experimental-https-cert ./certificates/localhost.pem",
    "dev:http": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "worker:build": "esbuild worker/index.ts --bundle --platform=node --format=cjs --target=node22 --packages=external --alias:server-only=./worker/server-only-stub.ts --tsconfig=tsconfig.json --outfile=dist-worker/worker.cjs",
    "worker:check": "node dist-worker/worker.cjs --check",
    "worker:start": "node dist-worker/worker.cjs",
    "verify:production": "esbuild scripts/gate/run.ts --bundle --platform=node --format=cjs --target=node22 --packages=external --tsconfig=tsconfig.json --outfile=dist-gate/gate.cjs && node --env-file-if-exists=.env.gate dist-gate/gate.cjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.116.0",
    "@base-ui/react": "^1.6.0",
    "@react-pdf/renderer": "^4.9.0",
    "@sentry/core": "^11.2.0",
    "@sentry/nextjs": "^11.2.0",
    "@sentry/node": "^11.2.0",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.111.0",
    "@tanstack/react-table": "^8.21.3",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "imapflow": "^2.1.0",
    "lucide-react": "^1.28.0",
    "mailparser": "^3.9.29",
    "motion": "^12.43.0",
    "next": "16.3.6",
    "next-themes": "^0.4.6",
    "nodemailer": "^10.0.10",
    "nprogress": "^0.2.0",
    "pdf-parse": "^2.4.5",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.4",
    "react-is": "^19.3.0",
    "react-resizable-panels": "^4.12.4",
    "recharts": "^3.8.0",
    "reicon-react": "^1.2.5",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/nprogress": "^0.2.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^3.2.7",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "picomatch": "^4.0.7",
    "shadcn": "^4.21.0",
    "supabase": "^2.118.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^7.3.6",
    "vitest": "^3.2.7"
  }
}
